.mtj.tmp/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven target folder
target/

# Eclipse files
.classpath
.project
.settings/

# IntelliJ IDEA files
.idea/
*.iml
*.iws

# VS Code
.vscode/

# Mac system files
.DS_Store

# Windows system files
Thumbs.db
